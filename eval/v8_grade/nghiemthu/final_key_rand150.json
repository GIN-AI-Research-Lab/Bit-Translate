  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 568,
  "ja": "なんとなく気分が晴れないんだよね。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 1084,
  "ja": "文化財の保存には多額の費用がかかり、自治体の財源不足が修復の遅れを招いている。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
