  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 246,
  "ja": "お手数をおかけいたしますが、ご対応をお願いいたします。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 783,
  "ja": "マニュアル通りに設定したのに、全く動かない。",
