  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 593,
  "ja": "どうしてもやる気が出ない、そんな日もある。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 528,
  "ja": "お弁当作る気力が今日はなかった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 482,
  "ja": "うちの子、なんでそんなに甘えん坊なんだろう。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 308,
  "ja": "御見積の内容にご不明点がございましたら、遠慮なくお申し付けください。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 224,
  "ja": "会議室、空いてる？",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 1180,
  "ja": "政治的な分断が深まる社会では、少数意見への配慮がとかく後回しにされやすい。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 192,
  "ja": "彼女の笑顔を見ると、こっちまで幸せな気分になる。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 914,
  "ja": "湿度が高い日は、汗が全然乾かない。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 70,
  "ja": "今夜はカレーにしようと思って、材料を買ってきた。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 66,
  "ja": "このリンクをクリックすると、詳細ページに移動します。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 205,
  "ja": "すみません、遅れます！",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 472,
  "ja": "台風来るらしいから気をつけて。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 502,
  "ja": "マジで！？",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 1096,
  "ja": "有権者の政治的無関心は、民主主義そのものの基盤を揺るがしかねない問題である。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 59,
  "ja": "このサイト、最近ログインするたびにエラーが出るんだよね。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 432,
  "ja": "あの子とはもう疎遠になっちゃったな。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 909,
  "ja": "気温が急に下がったから、風邪をひかないように。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 476,
  "ja": "お財布忘れて、レジで焦った。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 971,
  "ja": "駐車場はどこにありますか。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 599,
  "ja": "振り返ってみると、大変なこともあったけど、それなりに充実した一日だった気がする。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 15,
  "ja": "なんでこんなに時間が経つの早いんだろう。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 350,
  "ja": "あの案件、もう手遅れなんじゃないかな。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 915,
  "ja": "秋の空は澄んでいて、遠くの山まで見える。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 735,
  "ja": "会議アプリの音声が途切れて、内容がよく聞こえなかった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 342,
  "ja": "決裁が下りるまで、もう少しお時間をいただけますか。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 465,
  "ja": "天気良かったら公園行こうか。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 725,
  "ja": "新作映画の配信、いつ始まるんだろう?",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 203,
  "ja": "恐れ入りますが、来週の火曜日までにご返信いただけますでしょうか。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 818,
  "ja": "ホステルは安いけど、部屋が狭いんだよね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 213,
  "ja": "お忙しいところ恐縮ですが、ご確認いただけますと幸いです。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 775,
  "ja": "ドローンを使った測量作業、効率がすごく上がったらしい。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 743,
  "ja": "カートに入れたまま忘れていた商品、セール中に買っておいた。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 570,
  "ja": "どうしてこんなに不器用なんだろう、自分でも呆れる。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 96,
  "ja": "無理をしないで、今日はゆっくり体を休めてください。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 994,
  "ja": "暗くなってきたから、気をつけて帰ってね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1162,
  "ja": "文化予算の国内総生産比は主要国の中でも低く、芸術支援の拡充を求める声が根強い。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 272,
  "ja": "転職エージェントから紹介された会社、条件は悪くない。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 815,
  "ja": "展望台からの夜景は本当に感動的だった。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 174,
  "ja": "本当にありがとう、助かったよ。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 1194,
  "ja": "専門分野には専門家の知見を生かすべきだという原則は、行政の現場でも軽視されがちだ。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 630,
  "ja": "パスワード管理アプリを使い始めてから管理が楽になった。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 780,
  "ja": "産業用ロボットの導入で、工場の生産効率が大きく上がった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 418,
  "ja": "床にホコリがたまってきたな。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 154,
  "ja": "うまくいかないときこそ、基本に立ち返ることが大切だ。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 102,
  "ja": "紅葉の季節になると、山全体が赤や黄色に染まる。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 491,
  "ja": "静かにしてくれない？",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 622,
  "ja": "二段階認証を設定しておくと安心です。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 176,
  "ja": "また今度ゆっくり話そうね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 221,
  "ja": "新入社員の研修プログラムを見直すべきだと思います。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 980,
  "ja": "やっぱり日本の夏は蒸し暑いなあ。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 787,
  "ja": "チャットサポートの対応、すごく丁寧で助かった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 357,
  "ja": "契約解除の手続きについて、詳しく教えてもらえますか。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 798,
  "ja": "もっと早く知っておきたかった便利な機能だ。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 766,
  "ja": "家電同士が連携すると、こんなに便利になるとは思わなかった。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 454,
  "ja": "ガーデニングって思ったより奥が深いんだよね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 575,
  "ja": "娘はおかげさまで元気に育っています。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 158,
  "ja": "やらずに後悔するより、やって後悔したほうがましだ。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 374,
  "ja": "御社製品のカタログを送付させていただきます。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 1157,
  "ja": "対立の末に組織にもたらされた傷は、簡単には癒えないとの見方が根強い。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 358,
  "ja": "さすがベテラン、対応が早いね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 1000,
  "ja": "政府は来年度予算案において社会保障費を前年比三・二パーセント増となる三十八兆円台に積み上げる方針を固めた。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 817,
  "ja": "現地のガイドさんがとても親切に案内してくれた。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 582,
  "ja": "あ、雨降ってきた！",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 474,
  "ja": "スーパー行くけど、何か欲しいものある？",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 700,
  "ja": "防水機能つきのガジェットは、やっぱり安心感がある。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 125,
  "ja": "本当のことを言うと、あの映画はそれほど面白くなかった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 495,
  "ja": "また忘れたの？ほんと勘弁してよ。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 679,
  "ja": "SNSを見る時間を減らしたら、なんだか気持ちが楽になった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 871,
  "ja": "足首をひねってしまって、歩くのがつらい。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 577,
  "ja": "お義母さんの手料理、本当に美味しかったです。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 147,
  "ja": "情報があふれる時代だからこそ、何を信じるかを見極める力が求められる。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 457,
  "ja": "料理のレシピ、新しいの試してみたい。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 677,
  "ja": "インスタのストーリー機能、意外と使いやすい。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 460,
  "ja": "編み物って地味に見えて、意外と楽しいんだよ。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1081,
  "ja": "地域コミュニティの希薄化は、災害時の助け合いの機能を弱める要因になっている。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 860,
  "ja": "最近、頭痛がひどくて困っている。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 993,
  "ja": "親切に道を教えていただいて、本当にありがとうございました。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 315,
  "ja": "予算案、上に通すの結構大変そうだな。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 571,
  "ja": "お世話になっております、いつもありがとうございます。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 532,
  "ja": "奥さんの誕生日、何をプレゼントしようか悩んでる。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1167,
  "ja": "リスクを取らない経営に、大きな成長は望めない。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 567,
  "ja": "すごく感動して、思わず涙が出た。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 928,
  "ja": "昨日のオリンピックの決勝、見た？",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 867,
  "ja": "腰が痛くて、長時間座っていられない。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 781,
  "ja": "サポートに問い合わせたのに、返信が全然来ない。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 306,
  "ja": "貴社のご発展を心よりお祈り申し上げます。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1106,
  "ja": "他国の制度を過度に理想化することにも、危うさがあるとの指摘は根強い。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 1068,
  "ja": "「切磋琢磨」という言葉が示すように、競争は必ずしも敵対を意味するものではない。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 200,
  "ja": "失敗したからといって、それがすべての終わりというわけではない。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": true
 },
 {
  "id": 105,
  "ja": "予算が限られているので、なるべく安く抑えたいんです。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 240,
  "ja": "これで契約は成立ということでよろしいでしょうか。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 336,
  "ja": "最近入った子、電話対応がだいぶ上手くなったね。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 351,
  "ja": "何度も催促してすみません。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 142,
  "ja": "成功する人としない人の違いは、才能よりも継続する力にあると思う。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 830,
  "ja": "パンを焼くときは、発酵の時間が大事らしい。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": true
 },
 {
  "id": 822,
  "ja": "お米は何合炊きますか。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 1013,
  "ja": "若者の投票率は前回の選挙でわずか三十四パーセントにすぎず、政治への関心の低さが浮き彫りになった。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1146,
  "ja": "デジタル教育の推進は、教員自身のICTスキル向上という新たな課題を生んでいる。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 541,
  "ja": "お腹ペコペコだよー。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1197,
  "ja": "学ぶことの本質は、正解を覚えることではなく問いを立てる姿勢にあるのかもしれない。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 25,
  "ja": "これはいくらですか。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 251,
  "ja": "ボーナスの査定基準がいまだによく分からない。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 1163,
  "ja": "教育の機会均等という理念は、現実の家庭の経済力によって大きく揺らいでいる。",
  "A_sys": "v7a",
  "B_sys": "avg",
  "identical": false
 },
 {
  "id": 631,
  "ja": "クラウドにバックアップしておけば、機種変更のときも安心です。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
  "id": 942,
  "ja": "次の角を右に曲がってください。",
  "A_sys": "avg",
  "B_sys": "v7a",
  "identical": false
 },
 {
