[
 {
  "id": 6,
  "ja": "最近、運動不足で体がなまってる気がする。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 31,
  "ja": "先日はお忙しい中、お時間をいただきありがとうございました。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 33,
  "ja": "恐れ入りますが、担当者に代わっていただけますでしょうか。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "orig_mix"
 },
 {
  "id": 37,
  "ja": "申し訳ございませんが、その件については確認してから折り返します。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 73,
  "ja": "炊きたてのご飯に卵をかけるだけで最高のごちそうだ。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 83,
  "ja": "乗り換えが多くて、初めての人には少し分かりにくいかもしれない。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 88,
  "ja": "この駅から徒歩で十分ほどのところに有名なお寺があります。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 98,
  "ja": "今朝はぐっと冷え込んで、初めて息が白くなった。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "orig_mix"
 },
 {
  "id": 123,
  "ja": "一夜漬けではなく、日頃からコツコツ勉強するべきだった。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 124,
  "ja": "なんだか最近、彼、様子がおかしいと思わない。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 141,
  "ja": "人は誰しも、他人には言えない悩みの一つや二つは抱えているものだ。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 163,
  "ja": "雨上がりの空に、大きな虹がかかっていた。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "orig_mix"
 },
 {
  "id": 186,
  "ja": "どうりで今日は道が空いていたわけだ。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "orig_mix"
 },
 {
  "id": 207,
  "ja": "ご査収のほど、よろしくお願いいたします。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "work"
 },
 {
  "id": 226,
  "ja": "経費精算、まだ出してないの？",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 241,
  "ja": "財務部から予算超過の指摘を受けました。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 274,
  "ja": "あの新人、なかなか筋がいいね。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "work"
 },
 {
  "id": 286,
  "ja": "びっくりした、まさか内定もらえるとは！",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 292,
  "ja": "その話、結局白紙になったんだって。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "work"
 },
 {
  "id": 294,
  "ja": "履歴書の写真、いつのを使った？",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 297,
  "ja": "人手不足でシフトが回らない。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "work"
 },
 {
  "id": 305,
  "ja": "出張報告書は今週中に提出してください。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 339,
  "ja": "まったく状況が改善していないじゃないか！",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "work"
 },
 {
  "id": 411,
  "ja": "洗濯物、そろそろ干してくれない？",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "life"
 },
 {
  "id": 494,
  "ja": "塩、こっちに取ってもらえる？",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "life"
 },
 {
  "id": 508,
  "ja": "母がいつも作ってくれた味噌汁の味を思い出すと、なんだか懐かしくて実家に帰りたくなる。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "life"
 },
 {
  "id": 546,
  "ja": "珍しく機嫌いいじゃん、今日。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "life"
 },
 {
  "id": 553,
  "ja": "カラオケ行きたいけど、みんな予定合わないんだよなあ。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "life"
 },
 {
  "id": 581,
  "ja": "のど乾いた、何か飲み物ある？",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "life"
 },
 {
  "id": 634,
  "ja": "バックアップを取り忘れていたせいで、旅行中に撮った大切な写真や動画がすべて消えてしまい、しばらく立ち直れなかった。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 669,
  "ja": "新しいイベントが始まったから、ログインボーナスを取りに行かないと。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "tech"
 },
 {
  "id": 676,
  "ja": "知らない人からいきなりフォローされて、少し怖い。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 693,
  "ja": "充電の減りが早くて、このスマートウォッチはがっかりしている。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 694,
  "ja": "ワイヤレス充電に対応しているケース、地味に便利。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "tech"
 },
 {
  "id": 695,
  "ja": "見た目はかっこいいけど、機能はそこそこなガジェットだった。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 726,
  "ja": "音楽配信アプリのおすすめ機能、地味に優秀。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 731,
  "ja": "オンライン会議中に、急にマイクが聞こえなくなった。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "tech"
 },
 {
  "id": 733,
  "ja": "テレワークになってから、通勤時間がなくなって助かってる。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 767,
  "ja": "音声操作でエアコンをつけられるのは、地味にありがたい。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "tech"
 },
 {
  "id": 821,
  "ja": "味噌汁を作るには、まずだしを取る必要がある。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 828,
  "ja": "お弁当のおかずに悩んでいる。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 837,
  "ja": "賞味期限が切れているみたいだから、これは捨てよう。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 843,
  "ja": "これ、辛くないですか。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "travel"
 },
 {
  "id": 845,
  "ja": "ラーメンの替え玉お願いします。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 846,
  "ja": "アレルギーがあるので、卵は入れないでもらえますか。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 852,
  "ja": "デザートは別腹だよね。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 853,
  "ja": "コースメニューの中に、飲み物は含まれていますか。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "travel"
 },
 {
  "id": 855,
  "ja": "すみません、テーブルの上のこのお皿、下げてもらってもいいですか。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 857,
  "ja": "お腹いっぱい！もう一品も入らないよ。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "travel"
 },
 {
  "id": 917,
  "ja": "春一番が吹いて、花粉が一気に舞い上がった。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 940,
  "ja": "すみません、駅はどちらですか。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 983,
  "ja": "まさか、こんなに市場が混んでいるとは思わなかった。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "travel"
 },
 {
  "id": 989,
  "ja": "びっくりした！急に雷が鳴って、雨も降ってきた。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "travel"
 },
 {
  "id": 1002,
  "ja": "灯台下暗しというように、身近な課題ほど見過ごされやすいものだ。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1025,
  "ja": "地方創生を掲げる自治体の多くは、若年層の流出をいかに食い止めるかで苦慮している。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1027,
  "ja": "木を見て森を見ずという態度では、複雑化する国際情勢を正しく読み解くことはできない。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1050,
  "ja": "過疎地域における公共交通の縮小は、高齢者の生活の足を奪う深刻な問題となっている。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1077,
  "ja": "「玉石混交」のインターネット情報の中から真実を見極める力が、これからの教育に求められる。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1085,
  "ja": "経済学者の中には、賃金上昇こそがデフレ脱却の鍵だと主張する者が少なくない。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": true,
  "domain": "news"
 },
 {
  "id": 1087,
  "ja": "若年層の非婚化が進む背景には、経済的な不安定さが少なからず影響している。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1091,
  "ja": "「焼け石に水」との批判もあるが、政府は追加の物価対策を打ち出した。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1104,
  "ja": "看板だけに終わった地方創生事業も多く、成果が見えないとの指摘は根強い。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": false,
  "domain": "news"
 },
 {
  "id": 1148,
  "ja": "多文化共生社会が進む中、郷に従うことだけを求める発想はむしろ再考を要する。",
  "A_sys": "avg",
  "B_sys": "v8",
  "identical": true,
  "domain": "news"
 },
 {
  "id": 1198,
  "ja": "「捨てる神あれば拾う神あり」という言葉のとおり、支援を打ち切られた事業が別の形で再生することもある。",
  "A_sys": "v8",
  "B_sys": "avg",
  "identical": false,
  "domain": "news"
 }
]